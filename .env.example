# ---------------------------------------------------------------------------
# Estimate / contact form email delivery (Nodemailer over Gmail SMTP).
# Server-side only — these values are never sent to the browser.
#
# Local development: copy this file to .env.local and fill in SMTP_PASS.
# Production: set the same variables in your hosting provider's environment
# settings. Never commit real credentials.
# ---------------------------------------------------------------------------

# Gmail SMTP. Port 465 is implicit TLS; use 587 with SMTP_SECURE=false for STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# The Gmail account that authenticates and sends. Also used as the From address.
SMTP_USER=gilbertandsons2010@gmail.com

# REQUIRED. A 16-character Google App Password — NOT the normal account password.
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
# Leave empty here; set the real value in .env.local or your host's env settings.
SMTP_PASS=

# Where form submissions are delivered.
CONTACT_TO_EMAIL=gilbertandsons2010@gmail.com
